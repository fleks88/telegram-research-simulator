# Telegram bot token from @BotFather
CONTROL_BOT_TOKEN=

# Your numeric Telegram user ID (for example, get it from @userinfobot)
CONTROL_ADMIN_IDS=

# Shared API bearer token. Generate with: openssl rand -hex 32
API_TOKEN=

# Telegram API credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# One central test account username, without @
TELEGRAM_ALLOWED_RECIPIENTS=

# Local paths and API settings
API_BASE_URL=http://127.0.0.1:8000
DATABASE_PATH=data/telegram-research.sqlite3
TELEGRAM_SESSION_DIR=~/.telegram-research-simulator/sessions
MINIMUM_SEND_INTERVAL_SECONDS=30

# Optional OpenAI-compatible API, needed only for prompt auto-replies
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional API returning 24h activation totals and deltas for all six pack sizes
PACK_ACTIVATION_ENDPOINT=
PACK_ACTIVATION_API_TOKEN=