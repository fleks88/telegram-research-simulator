# Telegram bot token from @BotFather
CONTROL_BOT_TOKEN=

# Comma-separated operator IDs. Every operator receives manual-dialog alerts.
CONTROL_ADMIN_IDS=

# Shared API bearer token. Generate with: openssl rand -hex 32
API_TOKEN=

# Telegram API credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional legacy initial recipient. Change the active allowlist username in the bot.
TELEGRAM_ALLOWED_RECIPIENTS=

# Local paths and API settings
API_BASE_URL=http://127.0.0.1:8000
DATABASE_PATH=data/telegram-research.sqlite3
TELEGRAM_SESSION_DIR=~/.telegram-research-simulator/sessions
MINIMUM_SEND_INTERVAL_SECONDS=30
# Optional Telegram Desktop export used only for aggregate persona style statistics
PERSONA_CORPUS_PATH=result.json

# Optional OpenAI-compatible API, needed only for prompt auto-replies
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# API host for GET /activation-stats and its Bearer token
PACK_ACTIVATION_BASE_URL=https://stats.example.com
PACK_ACTIVATION_BEARER_TOKEN=
